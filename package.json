{
  "name": "taskbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w @taskbook/api\" \"npm run dev -w @taskbook/web\"",
    "start": "npm run start -w @taskbook/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:migrate": "npm run db:migrate -w @taskbook/api",
    "db:seed": "npm run db:seed -w @taskbook/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.69.0",
    "globals": "14.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.50.0"
  }
}
