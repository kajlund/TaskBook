{
  "name": "waymark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w @waymark/api\" \"npm run dev -w @waymark/web\"",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm test -ws --if-present",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:migrate": "npm run db:migrate -w @waymark/api",
    "db:seed": "npm run db:seed -w @waymark/api",
    "format": "prettier --write \"apps/**/*.{ts,css}\" \"packages/**/*.ts\" \"{apps,packages}/**/*.json\" \"*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,css}\" \"packages/**/*.ts\" \"{apps,packages}/**/*.json\" \"*.json\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.50.0"
  }
}
